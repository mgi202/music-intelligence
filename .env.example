# Music Intelligence System — environment variables
# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────
SQLITE_PATH=data/sqlite/library.db

# ── YouTube Music ─────────────────────────────────────────────
# Generate with: python scripts/setup_ytm_oauth.py
# Requires YTM_CLIENT_ID and YTM_CLIENT_SECRET below

# ── YouTube Music OAuth Client (Google Cloud Console) ─────────
# Create at: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Desktop app)
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
# This creates oauth.json in the project root.
YTM_OAUTH_FILE=oauth.json

# ── Last.fm ───────────────────────────────────────────────────
# Register at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# ── Discogs ───────────────────────────────────────────────────
# Register at https://www.discogs.com/settings/developers
DISCOGS_USER_TOKEN=

# ── ListenBrainz ──────────────────────────────────────────────
# Get token at https://listenbrainz.org/profile/
LISTENBRAINZ_TOKEN=
# Your ListenBrainz username. When set, the worker imports your listens each
# pass (worker stage 4) and powers the now-playing / recent-listens cards.
LISTENBRAINZ_USER=

# ── MusicBrainz ───────────────────────────────────────────────
# No API key required, but set a descriptive user agent.
MUSICBRAINZ_APP_NAME=MusicIntelligenceSystem
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT_EMAIL=

# ── Processing ────────────────────────────────────────────────
# Delay between enrichment API calls in seconds (be polite)
ENRICHMENT_RATE_LIMIT_SECONDS=1.0

# Number of tracks to process per enrichment run (0 = all pending)
ENRICHMENT_BATCH_SIZE=500

# ── Worker / observability ────────────────────────────────────
# Worker loop interval in minutes (default 360 = every 6 hours)
WORKER_INTERVAL_MINUTES=360
# Tracks enriched per worker pass
ENRICH_BATCH_SIZE=200
# ntfy.sh topic for failure alerts (leave blank to disable push alerts)
NTFY_TOPIC=
# Max full playlist-rewrite tracks pushed to YTM per pass (deferred beyond this)
MAX_REWRITE_TRACKS_PER_PASS=500
