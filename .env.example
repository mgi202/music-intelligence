# Music Intelligence System — environment variables
# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────
SQLITE_PATH=data/sqlite/library.db

# ── YouTube Music ─────────────────────────────────────────────
# Generate with: python scripts/setup_ytm_oauth.py
# Requires YTM_CLIENT_ID and YTM_CLIENT_SECRET below

# ── YouTube Music OAuth Client (Google Cloud Console) ─────────
# Create at: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Desktop app)
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
# This creates oauth.json in the project root.
YTM_OAUTH_FILE=oauth.json

# ── Last.fm ───────────────────────────────────────────────────
# Register at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Your Last.fm username. When set, the worker imports your scrobbles each pass
# (worker stage 4, source='lastfm') as a third listens history source.
LASTFM_USER=

# ── Discogs ───────────────────────────────────────────────────
# Register at https://www.discogs.com/settings/developers
DISCOGS_USER_TOKEN=

# ── ListenBrainz ──────────────────────────────────────────────
# Get token at https://listenbrainz.org/profile/
LISTENBRAINZ_TOKEN=
# Your ListenBrainz username. When set, the worker imports your listens each
# pass (worker stage 4) and powers the now-playing / recent-listens cards.
LISTENBRAINZ_USER=

# ── MusicBrainz ───────────────────────────────────────────────
# No API key required, but set a descriptive user agent.
MUSICBRAINZ_APP_NAME=MusicIntelligenceSystem
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT_EMAIL=

# ── Processing ────────────────────────────────────────────────
# Delay between enrichment API calls in seconds (be polite)
ENRICHMENT_RATE_LIMIT_SECONDS=1.0

# Number of tracks to process per enrichment run / worker pass (0 = all pending)
ENRICHMENT_BATCH_SIZE=500

# Days before a zero-match track (still metadata_only after an attempt) is retried
ENRICHMENT_RETRY_DAYS=7

# ── Worker / observability ────────────────────────────────────
# DAYTIME worker loop interval in minutes (default 360 = every 6 hours).
# Inside the night window the worker runs back-to-back night passes with
# NIGHT_PASS_GAP_MINUTES rest instead.
WORKER_INTERVAL_MINUTES=360
# DEPRECATED: use ENRICHMENT_BATCH_SIZE above (this name still works as a fallback)
# ENRICH_BATCH_SIZE=200
# ntfy.sh topic for failure alerts + the morning digest (blank = no pushes)
NTFY_TOPIC=
# Max full playlist-rewrite tracks pushed to YTM per pass (deferred beyond this)
MAX_REWRITE_TRACKS_PER_PASS=500

# ── Night window (Europe/London — the worker converts internally via
#    zoneinfo so DST is handled; the VPS clock stays UTC) ──────
NIGHT_WINDOW_START_HOUR=1
NIGHT_WINDOW_END_HOUR=7
# Batch sizes for night passes (day passes keep the daytime knobs above)
NIGHT_ENRICHMENT_BATCH_SIZE=2000
NIGHT_VERSION_DISCOVERY_BATCH_SIZE=200
# Official-video discovery (2026-07-05): rated tracks per pass searched for
# their real official video (quality-checks YTM's Song↔Video counterpart)
VIDEO_DISCOVERY_BATCH_SIZE=10
NIGHT_VIDEO_DISCOVERY_BATCH_SIZE=100
# Rest between back-to-back night passes, in minutes
NIGHT_PASS_GAP_MINUTES=5

# ── Morning digest ────────────────────────────────────────────
# The first pass ending at/after this London hour sends the digest (once/day)
DIGEST_HOUR=7

# ── Nightly jobs (1 = on, 0 = off; each runs at most once per night) ──
# REVIVED 2026-07-05: Job 8 now drives dynamic vocabulary expansion — family
# coverage vs tier quotas → suggestions queue (Tags tab + digest line). Keep ON.
TAG_FREQ_NIGHTLY=1
DEDUP_SCAN_NIGHTLY=1
DB_MAINTENANCE_NIGHTLY=1
# Python weekday() of the weekly VACUUM (6 = Sunday, pre-restore-drill)
VACUUM_WEEKDAY=6

# ── Bandcamp search sweep (Job 9 — capped, polite, night-only) ──
BANDCAMP_SWEEP_NIGHTLY=1
# Hard nightly lookup cap
BANDCAMP_SWEEP_BATCH_SIZE=500
# Sleep between Bandcamp requests, in seconds
BANDCAMP_SWEEP_RATE_SECONDS=4
