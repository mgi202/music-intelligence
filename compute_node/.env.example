# compute_node/.env — copy to compute_node/.env and fill in. NEVER commit .env.

# The server's tailnet address (music-intel-prod).
MIS_SERVER=http://100.77.32.111:8080

# Shared secret — must match AUDIO_NODE_TOKEN in the server's /opt/mis/.env.
AUDIO_NODE_TOKEN=

# Tailscale auth key for the container (Admin console → Settings → Keys →
# Generate auth key: REUSABLE + EPHEMERAL, tag it e.g. tag:compute-node).
# The container joins the tailnet as its own node ("mis-compute-node") and
# routes ONLY server calls through it; downloads stay on the home connection.
TS_AUTHKEY=

# Optional overrides:
# MIS_BATCH=4          # jobs per claim
# MIS_REPROCESS=1      # claim stale-vector reprocess jobs instead of fresh ones
